{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "① 启动网页仿真（Mac/Linux）",
      "type": "shell",
      "command": "bash run_web.sh ${input:port}",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "① 启动网页仿真（Windows）",
      "type": "shell",
      "command": "cd web_sim && python -m http.server ${input:port}",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "windows": { "command": "cd web_sim && python -m http.server ${input:port}" },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "② 物理核心自测（Node）",
      "type": "shell",
      "command": "node test_core.mjs",
      "options": { "cwd": "${workspaceFolder}/web_sim" },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "③ ROS2：编译桥接包",
      "type": "shell",
      "command": "bash -lc 'source /opt/ros/${input:rosDistro}/setup.bash && cd ros2_ws && colcon build --packages-select rm_aim_sim_bridge --symlink-install'",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "③ ROS2：启动桥接（ws://0.0.0.0:9090）",
      "type": "shell",
      "command": "bash -lc 'source /opt/ros/${input:rosDistro}/setup.bash && source ros2_ws/install/setup.bash && ros2 launch rm_aim_sim_bridge web_bridge.launch.xml'",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "④ ROS2：编译示例自瞄节点",
      "type": "shell",
      "command": "bash -lc 'source /opt/ros/${input:rosDistro}/setup.bash && source ros2_ws/install/setup.bash && cd ros2_ws && colcon build --packages-select student_auto_aim --symlink-install'",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "④ ROS2：运行示例自瞄节点",
      "type": "shell",
      "command": "bash -lc 'source /opt/ros/${input:rosDistro}/setup.bash && source ros2_ws/install/setup.bash && ros2 run student_auto_aim aim_node --ros-args -p use_sim_time:=true'",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "⑤ 起全套（网页 + 桥接 + 自瞄）",
      "dependsOrder": "parallel",
      "dependsOn": [
        "① 启动网页仿真（Mac/Linux）",
        "③ ROS2：启动桥接（ws://0.0.0.0:9090）",
        "④ ROS2：运行示例自瞄节点"
      ],
      "problemMatcher": []
    },
    {
      "label": "⑥ 链路自检（含下行指令测试）",
      "type": "shell",
      "command": "bash tools/check_link.sh --sweep",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "⑦ 只看数据（不动云台）",
      "type": "shell",
      "command": "bash -lc 'source /opt/ros/${input:rosDistro}/setup.bash && source ros2_ws/install/setup.bash && python3 tools/probe_bridge.py'",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "ROS2：查看话题频率 /aim_sim/armors",
      "type": "shell",
      "command": "bash -lc 'source /opt/ros/${input:rosDistro}/setup.bash && ros2 topic hz /aim_sim/armors'",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "port",
      "type": "promptString",
      "description": "网页端口",
      "default": "8080"
    },
    {
      "id": "rosDistro",
      "type": "pickString",
      "description": "ROS 2 发行版",
      "options": ["jazzy", "humble", "iron"],
      "default": "jazzy"
    }
  ]
}
